    context["delta_provmod_no"] = context["delta_provmod"][context["delta_provmod"]["Status"] == "NO"].copy()

    # Sales Delta
    context["delta_sales"] = extract_and_merge_df(
        context["sales"], context["transfer"], "lan_id", "lan_id", "left",
        "Sales", sales_current_report_date, sales_next_report_date, True
    )
