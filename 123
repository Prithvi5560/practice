def run(context: Dict) -> Dict:
    """Salesforce Transfer Delta."""

    logger.info("Starting Salesforce Transfer Delta process.")
    IO_object = IOLayer()

    global commerce_current_report_date
    global commerce_next_report_date
    global dental_current_report_date
    global dental_next_report_date
    global pcms_current_report_date
    global pcms_next_report_date
    global provmod_current_report_date
    global provmod_next_report_date
    global sales_current_report_date
    global sales_next_report_date
    global active_inactive_report_date
    global transfer_report_date

    properties = context.get("properties")
    if not properties:
        raise ValueError("Salesforce Transfer Delta: properties missing in context.")

    input_path = properties.get("input_path")
    input_files = properties.get("input_files")

    if not input_path:
        raise ValueError("Salesforce Transfer Delta: input_path missing.")
    if not input_files:
        raise ValueError("Salesforce Transfer Delta: input_files missing.")

    required_input_files = [
        "commerce_current_week_report",
        "commerce_next_week_report",
        "dental_current_week_report",
        "dental_next_week_report",
        "pcms_current_week_report",
        "pcms_next_week_report",
        "provmod_current_week_report",
        "provmod_next_week_report",
        "sales_current_week_report",
        "sales_next_week_report",
        "identity_active_report",
        "transfer_report",
    ]

    validate_input_file_configuration(input_files, required_input_files)

    configured_current_date = parse_configured_date(properties.get("current_report_date"))
    configured_next_date = parse_configured_date(properties.get("next_report_date"))
    configured_identity_date = parse_configured_date(
        properties.get("active_inactive_report_date")
    )
    configured_transfer_date = parse_configured_date(properties.get("transfer_report_date"))

    commerce_current_report_date = configured_current_date or get_date_from_filename(input_files["commerce_current_week_report"])
    commerce_next_report_date = configured_next_date or get_date_from_filename(input_files["commerce_next_week_report"])
    dental_current_report_date = configured_current_date or get_date_from_filename(input_files["dental_current_week_report"])
    dental_next_report_date = configured_next_date or get_date_from_filename(input_files["dental_next_week_report"])
    pcms_current_report_date = configured_current_date or get_date_from_filename(input_files["pcms_current_week_report"])
    pcms_next_report_date = configured_next_date or get_date_from_filename(input_files["pcms_next_week_report"])
    provmod_current_report_date = configured_current_date or get_date_from_filename(input_files["provmod_current_week_report"])
    provmod_next_report_date = configured_next_date or get_date_from_filename(input_files["provmod_next_week_report"])
    sales_current_report_date = configured_current_date or get_date_from_filename(input_files["sales_current_week_report"])
    sales_next_report_date = configured_next_date or get_date_from_filename(input_files["sales_next_week_report"])
    active_inactive_report_date = configured_identity_date or get_date_from_filename(input_files["identity_active_report"])
    transfer_report_date = configured_transfer_date or get_date_from_filename(input_files["transfer_report"])

    context["commerce_current_report_date"] = commerce_current_report_date
    context["commerce_next_report_date"] = commerce_next_report_date
    context["dental_current_report_date"] = dental_current_report_date
    context["dental_next_report_date"] = dental_next_report_date
    context["pcms_current_report_date"] = pcms_current_report_date
    context["pcms_next_report_date"] = pcms_next_report_date
    context["provmod_current_report_date"] = provmod_current_report_date
    context["provmod_next_report_date"] = provmod_next_report_date
    context["sales_current_report_date"] = sales_current_report_date
    context["sales_next_report_date"] = sales_next_report_date
    context["active_inactive_report_date"] = active_inactive_report_date
    context["transfer_report_date"] = transfer_report_date

    # Commerce Current / Next
    curr_commerce = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["commerce_current_week_report"]),
        "Commerce Current Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["commerce"] = curr_commerce

    next_commerce = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["commerce_next_week_report"]),
        "Commerce Next Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["next_commerce"] = next_commerce

    # Dental Current / Next
    curr_dental = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["dental_current_week_report"]),
        "Dental Current Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["dental"] = curr_dental

    next_dental = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["dental_next_week_report"]),
        "Dental Next Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["next_dental"] = next_dental

    # PCMS Current / Next
    curr_pcms = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["pcms_current_week_report"]),
        "PCMS Current Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["pcms"] = curr_pcms

    next_pcms = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["pcms_next_week_report"]),
        "PCMS Next Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["next_pcms"] = next_pcms

    # ProvMod Current / Next
    curr_provmod = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["provmod_current_week_report"]),
        "ProvMod Current Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["provmod"] = curr_provmod

    next_provmod = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["provmod_next_week_report"]),
        "ProvMod Next Week",
        ["LANID", "LANId", "LAN ID"],
    )
    context["next_provmod"] = next_provmod

    # Sales Current / Next
    curr_sales = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["sales_current_week_report"]),
        "Sales Current Week",
        ["LANId", "LANID", "LAN ID"],
    )
    context["sales"] = curr_sales

    next_sales = read_salesforce_report(
        IO_object,
        os.path.join(input_path, input_files["sales_next_week_report"]),
        "Sales Next Week",
        ["LANId", "LANID", "LAN ID"],
    )
    context["next_sales"] = next_sales

    # Identity Active / Inactive
    identity_active = IO_object.read_excel(
        source_path=os.path.join(input_path, input_files["identity_active_report"])
    )
    context["identity_active"] = get_first_sheet(identity_active, "Identity Active/Inactive Report")
    context["identity_active"].columns = [clean_column_name(c) for c in context["identity_active"].columns]

    identity_lan_column = find_column(context["identity_active"], ["LAN ID", "LANID", "LANId"])
